# Example Terraform variables for Development / Demo environment
aws_region          = "ap-southeast-2"
environment         = "dev"
key_name            = "pos-deployer-key"
ssh_allowed_ip      = "0.0.0.0/0" # Change to your_ip/32 for enhanced security

# Compute Sizing (Free-tier friendly)
app_instance_type     = "t3.micro"
jenkins_instance_type = "t3.medium" # Minimum 4GB RAM recommended for Jenkins + SonarQube

# Database Credentials
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_name              = "posdb"
db_username          = "posadmin"
db_password          = "PosSecurePassword123!"
