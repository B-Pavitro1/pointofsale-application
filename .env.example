# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=posdb
DB_USERNAME=posuser
DB_PASSWORD=your_database_password_here
DB_ROOT_PASSWORD=your_root_password_here

# Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security (Generate secure 64-byte key with: openssl rand -base64 64)
JWT_SECRET=your_base64_encoded_jwt_secret_at_least_32_characters_here
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:80

# AWS Credentials (used by Terraform and AWS CLI, never commit real values)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SonarQube Server Configuration
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token_here
